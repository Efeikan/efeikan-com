# Public site URL (used in sitemap, robots, canonical, Open Graph)
NEXT_PUBLIC_SITE_URL=https://efeikan.com

# Cloudflare Turnstile (optional — leave empty to skip the widget; honeypot still runs)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google reCAPTCHA v3 (optional alternative — widget is not rendered unless you wire it)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Vercel Analytics does not require an API key when the project is hosted on Vercel.
# On other hosts the script still loads; events are attributed once the project is linked.
